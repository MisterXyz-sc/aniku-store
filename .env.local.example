# Isi ini di Vercel Dashboard -> Project Settings -> Environment Variables
# JANGAN commit file .env.local yang udah keisi ke Git.

# Bisa dilihat di Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-anon-key-disini

# RAHASIA -- service_role key, JANGAN PERNAH dipakai di kode client-side.
# Cuma dipakai di app/api/** (server-side).
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key-disini

# Sama persis kayak env var yang dipakai di Edge Function Supabase
# (sakurupiah-create-invoice / sakurupiah-create-diamond-invoice).
# Cek nilainya di Supabase Dashboard -> Edge Functions -> Secrets.
SAKURUPIAH_API_ID=isi-api-id-sakurupiah
SAKURUPIAH_API_KEY=isi-api-key-sakurupiah
SAKURUPIAH_IS_PRODUCTION=true

